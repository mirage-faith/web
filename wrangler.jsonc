{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mirage-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "mirage.faith", "custom_domain": true },
    { "pattern": "www.mirage.faith", "custom_domain": true }
  ],
  "build": {
    "command": "node scripts/gen-build-info.mjs"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
